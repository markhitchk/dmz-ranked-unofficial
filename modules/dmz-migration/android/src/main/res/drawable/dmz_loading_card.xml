<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="@color/dmz_panel" android:endColor="@color/dmz_panel_deep" />
            <stroke android:width="1dp" android:color="#4A504D" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:gravity="left" android:width="4dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/dmz_gold" />
            <corners android:topLeftRadius="12dp" android:bottomLeftRadius="12dp" />
        </shape>
    </item>
</layer-list>
