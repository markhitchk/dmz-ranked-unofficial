<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="@color/dmz_panel" android:endColor="@color/dmz_panel_deep" />
            <stroke android:width="1dp" android:color="@color/dmz_card_border" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:gravity="bottom" android:height="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/dmz_gold_dark" />
        </shape>
    </item>
</layer-list>
