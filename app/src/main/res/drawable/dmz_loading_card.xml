<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#171B18" android:endColor="#0B0F0D" />
            <stroke android:width="1dp" android:color="#545A54" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:gravity="left" android:width="4dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="@color/dmz_gold" android:endColor="@color/dmz_gold_dark" />
            <corners android:topLeftRadius="16dp" android:bottomLeftRadius="16dp" />
        </shape>
    </item>
</layer-list>
