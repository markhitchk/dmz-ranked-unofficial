<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/dmz_toolbar" />
        </shape>
    </item>
    <item android:gravity="bottom" android:height="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="@color/dmz_red"
                android:centerColor="@color/dmz_green"
                android:endColor="@color/dmz_red" />
        </shape>
    </item>
</layer-list>
