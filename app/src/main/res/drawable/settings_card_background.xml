<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#151A17"
                android:endColor="#0E120F" />
            <stroke android:width="1dp" android:color="@color/dmz_card_border" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:gravity="left" android:width="3dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/dmz_gold" />
            <corners
                android:topLeftRadius="10dp"
                android:bottomLeftRadius="10dp" />
        </shape>
    </item>
</layer-list>
