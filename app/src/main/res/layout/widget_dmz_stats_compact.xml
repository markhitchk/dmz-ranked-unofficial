<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_dmz_background"
    android:orientation="vertical"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widgetRankBadge"
            android:layout_width="42dp"
            android:layout_height="46dp"
            android:layout_marginEnd="8dp"
            android:contentDescription="Rank badge"
            android:scaleType="fitCenter"
            android:src="@drawable/dmz_ranked_logo" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/widgetAppLogo"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="DMZ Ranked"
                    android:scaleType="centerInside"
                    android:src="@drawable/dmz_ranked_logo" />

                <TextView
                    android:id="@+id/widgetAppTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:fontFamily="sans-serif-condensed"
                    android:text="DMZ RANKED"
                    android:textColor="@color/dmz_white"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widgetBetaTag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:background="@drawable/toolbar_beta_badge"
                    android:paddingStart="5dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="5dp"
                    android:paddingBottom="2dp"
                    android:text="[BETA]"
                    android:textColor="@color/dmz_black"
                    android:textSize="7sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/widgetStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:background="@drawable/widget_dmz_status_background"
                    android:paddingStart="5dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="5dp"
                    android:paddingBottom="2dp"
                    android:text="LIVE"
                    android:textColor="@color/dmz_gold"
                    android:textSize="7sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/widgetOperator"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-condensed"
                android:maxLines="1"
                android:text="DMZ RANKED"
                android:textColor="@color/dmz_white"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widgetRank"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Loading…"
                android:textColor="@color/dmz_gold"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/widgetRefresh"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="5dp"
            android:background="@drawable/widget_dmz_refresh_background"
            android:gravity="center"
            android:text="↻"
            android:textColor="@color/dmz_white"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widgetStatsRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widgetSr"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.2"
            android:fontFamily="sans-serif-condensed"
            android:text="… SR"
            android:textColor="@color/dmz_white"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widgetPosition"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="#… / …"
            android:textColor="@color/dmz_white"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widgetDelta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="end"
            android:maxLines="1"
            android:text="+0 SR"
            android:textColor="@color/dmz_muted"
            android:textSize="9sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/widgetProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginTop="3dp"
        android:max="100"
        android:progress="0"
        android:progressBackgroundTint="@color/dmz_card_border"
        android:progressTint="@color/dmz_gold" />

    <LinearLayout
        android:id="@+id/widgetFooterRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widgetBrandSubtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="MADE BY HARLEY'S STUDIOS"
            android:textColor="@color/dmz_muted"
            android:textSize="7sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widgetFooter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="LIVE"
            android:textColor="@color/dmz_muted"
            android:textSize="7sp" />

        <TextView
            android:id="@+id/widgetSeason"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="SEASON"
            android:textColor="@color/dmz_gold"
            android:textSize="7sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
