<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dmz_black"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/titleBar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@drawable/toolbar_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="10dp">

        <ImageView
            android:id="@+id/titleLogo"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:contentDescription="DMZ Ranked logo"
            android:scaleType="centerInside"
            android:src="@drawable/dmz_ranked_logo" />

        <TextView
            android:id="@+id/titleText"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-condensed"
            android:gravity="center_vertical"
            android:letterSpacing="0.02"
            android:text="DMZ Ranked"
            android:textAllCaps="false"
            android:textColor="@color/dmz_white"
            android:textSize="25sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/settingsButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/settings"
            android:padding="10dp"
            android:src="@drawable/ic_settings" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:max="100"
        android:progressDrawable="@drawable/dmz_progress_track"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/dmz_black" />

        <ScrollView
            android:id="@+id/loadingOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/dmz_loading_background"
            android:fillViewport="true"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:minHeight="560dp"
                android:orientation="vertical"
                android:paddingStart="22dp"
                android:paddingTop="30dp"
                android:paddingEnd="22dp"
                android:paddingBottom="30dp">

                <ImageView
                    android:id="@+id/loadingLogo"
                    android:layout_width="118dp"
                    android:layout_height="118dp"
                    android:contentDescription="DMZ Ranked logo"
                    android:scaleType="centerInside"
                    android:src="@drawable/dmz_ranked_logo" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="sans-serif-condensed"
                    android:letterSpacing="0.18"
                    android:text="DMZ"
                    android:textColor="@color/dmz_gold"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-condensed"
                    android:letterSpacing="0.08"
                    android:text="RANKED"
                    android:textColor="@color/dmz_white"
                    android:textSize="42sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-5dp"
                    android:fontFamily="sans-serif-condensed"
                    android:letterSpacing="0.05"
                    android:text="LEADERBOARD"
                    android:textColor="@color/dmz_gold"
                    android:textSize="31sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:fontFamily="sans-serif-condensed"
                    android:letterSpacing="0.20"
                    android:text="AL MAZRAH • SEASON STANDINGS"
                    android:textColor="@color/dmz_gold_soft"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/dmz_status_chip"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="●"
                        android:textColor="@color/dmz_green"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="7dp"
                        android:fontFamily="sans-serif-condensed"
                        android:letterSpacing="0.08"
                        android:text="LIVE • CONNECTING"
                        android:textColor="@color/dmz_white"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:background="@drawable/dmz_loading_card"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingTop="18dp"
                    android:paddingEnd="18dp"
                    android:paddingBottom="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-condensed"
                        android:letterSpacing="0.12"
                        android:text="LOADING DMZ RANKED"
                        android:textColor="@color/dmz_white"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/loadingStageText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:fontFamily="sans-serif-condensed"
                        android:text="Connecting to dmzranked.com…"
                        android:textColor="@color/dmz_muted"
                        android:textSize="13sp" />

                    <ProgressBar
                        android:id="@+id/loadingProgressBar"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:layout_marginTop="16dp"
                        android:max="100"
                        android:progress="0"
                        android:progressDrawable="@drawable/dmz_progress_track" />

                    <TextView
                        android:id="@+id/loadingVerboseText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9dp"
                        android:fontFamily="monospace"
                        android:gravity="end"
                        android:text="0%"
                        android:textColor="@color/dmz_gold_soft"
                        android:textSize="11sp"
                        android:visibility="gone" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:fontFamily="sans-serif-condensed"
                    android:letterSpacing="0.08"
                    android:text="DMZRANKED.COM • UNOFFICIAL ANDROID CLIENT"
                    android:textColor="@color/dmz_muted"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>
</LinearLayout>
