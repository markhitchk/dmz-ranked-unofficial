<?xml version="1.0" encoding="utf-8"?>
<!--
  Ranked Hub Beta intentionally uses a non-adaptive transparent icon.
  Some launchers paint an opaque black rounded-square behind adaptive icon
  foregrounds even if adaptive-icon's background is transparent. The original
  logo has a real alpha channel, so preserve it directly as a BitmapDrawable.
  Production DMZRanked.com keeps its existing adaptive icons unchanged.
-->
<bitmap xmlns:android="http://schemas.android.com/apk/res/android"
    android:src="@drawable/ranked_hub_logo"
    android:gravity="fill" />
